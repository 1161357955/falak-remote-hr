{
  "name": "RemoteWorker",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "national_id": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629"
    },
    "gender": {
      "type": "string",
      "title": "\u0627\u0644\u062c\u0646\u0633",
      "enum": [
        "\u0630\u0643\u0631",
        "\u0623\u0646\u062b\u0649"
      ]
    },
    "is_disabled": {
      "type": "boolean",
      "title": "\u0645\u0646 \u0630\u0648\u064a \u0627\u0644\u0625\u0639\u0627\u0642\u0629",
      "default": false
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "city": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "region": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629"
    },
    "job_title": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "work_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645",
      "enum": [
        "\u062f\u0648\u0627\u0645 \u0643\u0627\u0645\u0644",
        "\u062f\u0648\u0627\u0645 \u062c\u0632\u0626\u064a"
      ],
      "default": "\u062f\u0648\u0627\u0645 \u0643\u0627\u0645\u0644"
    },
    "salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628"
    },
    "company_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0646\u0634\u0637",
        "\u0645\u0639\u0644\u0642",
        "\u0645\u0646\u062a\u0647\u064a"
      ],
      "default": "\u0646\u0634\u0637"
    },
    "contract_start": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0639\u0642\u062f"
    },
    "contract_end": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0639\u0642\u062f"
    },
    "agreed_work_days": {
      "type": "number",
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647\u0627",
      "default": 5
    },
    "annual_leave_days": {
      "type": "number",
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u0625\u062c\u0627\u0632\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629",
      "default": 21
    },
    "last_active_at": {
      "type": "string",
      "title": "\u0622\u062e\u0631 \u0646\u0634\u0627\u0637"
    }
  },
  "required": [
    "full_name",
    "national_id",
    "company_id"
  ]
}