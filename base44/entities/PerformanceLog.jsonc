{
  "name": "PerformanceLog",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "login_time": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062f\u062e\u0648\u0644"
    },
    "logout_time": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062e\u0631\u0648\u062c"
    },
    "hours_worked": {
      "type": "number",
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644",
      "default": 0
    },
    "tasks_assigned": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0648\u0643\u0644\u0629",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0646\u062c\u0632\u0629",
      "default": 0
    },
    "activity_level": {
      "type": "string",
      "title": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0646\u0634\u0627\u0637",
      "enum": [
        "\u0645\u0645\u062a\u0627\u0632",
        "\u062c\u064a\u062f \u062c\u062f\u0627\u064b",
        "\u062c\u064a\u062f",
        "\u0645\u0642\u0628\u0648\u0644",
        "\u0636\u0639\u064a\u0641"
      ],
      "default": "\u062c\u064a\u062f"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "worker_id",
    "date"
  ]
}