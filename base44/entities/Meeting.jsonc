{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "meeting_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639",
      "enum": [
        "\u0641\u0631\u062f\u064a",
        "\u062c\u0645\u0627\u0639\u064a"
      ],
      "default": "\u062c\u0645\u0627\u0639\u064a"
    },
    "organizer_name": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0638\u0645"
    },
    "organizer_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0646\u0638\u0645"
    },
    "participant_emails": {
      "type": "array",
      "title": "\u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0648\u0646",
      "items": {
        "type": "string"
      }
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "meeting_time": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "duration_minutes": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u062f\u0629 (\u062f\u0642\u064a\u0642\u0629)",
      "default": 30
    },
    "meeting_link": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0645\u062c\u062f\u0648\u0644\u0629",
        "\u0645\u0646\u0639\u0642\u062f\u0629",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "default": "\u0645\u062c\u062f\u0648\u0644\u0629"
    }
  },
  "required": [
    "title",
    "meeting_date"
  ]
}