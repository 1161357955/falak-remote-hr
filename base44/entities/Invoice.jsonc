{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "company_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "period": {
      "type": "string",
      "title": "\u0641\u062a\u0631\u0629 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 (\u0634\u0647\u0631)"
    },
    "workers_count": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646",
      "default": 0
    },
    "subscription_amount": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u0634\u0647\u0631\u064a",
      "default": 0
    },
    "setup_fee_amount": {
      "type": "number",
      "title": "\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0623\u0633\u064a\u0633",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a",
      "default": 0
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642"
    },
    "status": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0633\u062f\u0627\u062f",
      "enum": [
        "\u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639\u0629",
        "\u0645\u062f\u0641\u0648\u0639\u0629"
      ],
      "default": "\u063a\u064a\u0631 \u0645\u062f\u0641\u0648\u0639\u0629"
    },
    "reminder_sent": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u062a\u0630\u0643\u064a\u0631",
      "default": false
    }
  },
  "required": [
    "invoice_number",
    "company_id",
    "period",
    "total_amount"
  ]
}