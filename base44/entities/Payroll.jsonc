{
  "name": "Payroll",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "company_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "period": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u062a\u0631\u0629 (\u0633\u0646\u0629-\u0634\u0647\u0631)"
    },
    "target_hours": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 (48 \u0633\u0627\u0639\u0629 \u0623\u0633\u0628\u0648\u0639\u064a\u0627\u064b)"
    },
    "actual_hours": {
      "type": "number",
      "title": "\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0641\u0639\u0644\u064a\u0629"
    },
    "compliance_percentage": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0627\u0644\u062a\u063a\u0637\u064a\u0629"
    },
    "hourly_rate": {
      "type": "number",
      "title": "\u0627\u0644\u0623\u062c\u0631 \u0628\u0627\u0644\u0633\u0627\u0639\u0629"
    },
    "base_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a"
    },
    "calculated_wage": {
      "type": "number",
      "title": "\u0627\u0644\u0623\u062c\u0631 \u0627\u0644\u0645\u0633\u062a\u062d\u0642"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0645\u0635\u062f\u0631",
        "\u0645\u062f\u0641\u0648\u0639"
      ],
      "default": "\u0645\u0635\u062f\u0631"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    }
  },
  "required": [
    "worker_id",
    "period"
  ]
}