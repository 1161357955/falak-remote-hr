{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0647\u0645\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0645\u0647\u0645\u0629"
    },
    "project_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "worker_id": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0645\u0633\u0624\u0648\u0644"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u062c\u062f\u064a\u062f\u0629",
        "\u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630",
        "\u0645\u0643\u062a\u0645\u0644\u0629",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "default": "\u062c\u062f\u064a\u062f\u0629"
    },
    "priority": {
      "type": "string",
      "title": "\u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629",
      "enum": [
        "\u0645\u0646\u062e\u0641\u0636\u0629",
        "\u0645\u062a\u0648\u0633\u0637\u0629",
        "\u0639\u0627\u0644\u064a\u0629",
        "\u0639\u0627\u062c\u0644\u0629"
      ],
      "default": "\u0645\u062a\u0648\u0633\u0637\u0629"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "estimated_hours": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0631\u0629"
    },
    "actual_hours": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u0629",
      "default": 0
    },
    "reminder_sent": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u062a\u0630\u0643\u064a\u0631",
      "default": false
    },
    "google_task_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0647\u0645\u0629 \u0641\u064a Google Tasks"
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}